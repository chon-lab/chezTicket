# ---------------------------------------------------------------------------
# Copie este arquivo para .env antes de subir o ambiente:
#   cp .env.example .env
# O arquivo .env NÃO é versionado (contém credenciais locais).
# ---------------------------------------------------------------------------

# Banco de dados MariaDB
MARIADB_DATABASE=chezticket
MARIADB_USER=chezticket
MARIADB_PASSWORD=chezticket
MARIADB_ROOT_PASSWORD=root

# Portas publicadas no host
DB_HOST_PORT=8080
BACKEND_HOST_PORT=8081
ADMINER_HOST_PORT=8090

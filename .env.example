# ---------------------------------------------------------------------------
# Copie este arquivo para .env antes de subir o ambiente:
#   cp .env.example .env
# O arquivo .env NÃO é versionado (contém credenciais locais).
# ---------------------------------------------------------------------------

# Banco de dados MariaDB
MARIADB_DATABASE=chezticket
MARIADB_USER=chezticket
MARIADB_PASSWORD=chezticket
MARIADB_ROOT_PASSWORD=root

# Portas publicadas no host
DB_HOST_PORT=8080
BACKEND_HOST_PORT=8081
ADMINER_HOST_PORT=8090

# Front usado para montar as URLs de volta (success/cancel) do Stripe Checkout
CHEZTICKET_FRONTEND_URL=http://localhost:5173

# Stripe (chaves de TESTE — dashboard.stripe.com/test/apikeys). Sem elas, o
# checkout pago falha com uma mensagem clara em vez de tentar cobrar de verdade.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# E-mail de confirmação do ingresso (Gmail SMTP por padrão — veja SPRING_MAIL_HOST
# em docker-compose.yml para trocar de provedor). SPRING_MAIL_USERNAME é o e-mail
# remetente; SPRING_MAIL_PASSWORD é uma "senha de app" do Google (myaccount.google.com/apppasswords),
# nunca a senha normal da conta. Sem isso, o envio só é pulado (ver application.yml).
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
